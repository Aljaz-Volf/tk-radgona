FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value
# PostgreSQL example: postgresql+psycopg://user:password@host/database?sslmode=require
# Relative SQLite paths are resolved inside Flask's instance directory.
DATABASE_URL=sqlite:///tenis.db
SESSION_COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
UPLOAD_FOLDER=instance/uploads
MAX_CONTENT_LENGTH=10485760
# Use local only for development. Production: set s3 and the values below.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public CDN/bucket base. Without it the app returns short-lived signed URLs.
S3_PUBLIC_BASE_URL=
COURTIPLAY_URL=https://courtiplay.com
# Optional SMTP settings for password reset email.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

